{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zeptly:tiny-agents:schema:eval-result",
  "title": "Blueprint evaluation result (PROVISIONAL)",
  "type": "object",
  "additionalProperties": false,
  "required": ["resultVersion", "synthetic", "subject", "suiteDigest", "summary", "caseResults"],
  "properties": {
    "resultVersion": { "const": "eval-result/v0-provisional" },
    "synthetic": { "type": "boolean", "description": "true = fabricated example data, not a real evaluation run." },
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "$ref": "urn:zeptly:tiny-agents:schema:common#/$defs/registryId" }, "version": { "$ref": "urn:zeptly:tiny-agents:schema:common#/$defs/semver" } }
    },
    "suiteDigest": { "$ref": "urn:zeptly:tiny-agents:schema:common#/$defs/digest" },
    "runner": { "type": "string", "maxLength": 100 },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["cases", "passed", "passRate"],
      "properties": {
        "cases": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "caseResults": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["case", "passed"],
        "properties": { "case": { "type": "string" }, "passed": { "type": "boolean" } }
      }
    }
  }
}
