{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zeptly:tiny-agents:schema:sanitisation-report",
  "title": "Sanitisation / generalisation report (PROVISIONAL)",
  "description": "Attests that procedure was generalised and tenant data excluded. Bound to blueprint.yaml by digest. The privacy scanner re-runs independently in CI; this report never substitutes for it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reportVersion", "synthetic", "subject", "blueprintDigest", "checks", "generalisation", "reviewer"],
  "properties": {
    "reportVersion": { "const": "sanitisation-report/v0-provisional" },
    "synthetic": { "type": "boolean" },
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "$ref": "urn:zeptly:tiny-agents:schema:common#/$defs/registryId" }, "version": { "$ref": "urn:zeptly:tiny-agents:schema:common#/$defs/semver" } }
    },
    "blueprintDigest": { "$ref": "urn:zeptly:tiny-agents:schema:common#/$defs/digest" },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "result", "findings"],
        "properties": {
          "kind": { "enum": ["secret-scan", "pii-scan", "workspace-identifier-scan", "concrete-config-scan", "denylist", "free-text-review", "slot-generalisation", "synthetic-examples"] },
          "result": { "enum": ["pass", "fail"] },
          "findings": { "type": "integer", "minimum": 0 },
          "tool": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "generalisation": {
      "type": "object", "additionalProperties": false,
      "required": ["tenantContentRemoved", "tenantSpecificValuesBoundToSlots", "summary"],
      "properties": {
        "tenantContentRemoved": { "type": "boolean" },
        "tenantSpecificValuesBoundToSlots": { "type": "boolean" },
        "summary": { "$ref": "urn:zeptly:tiny-agents:schema:common#/$defs/shortText" }
      }
    },
    "reviewer": {
      "type": "object", "additionalProperties": false, "required": ["kind", "identity"],
      "properties": { "kind": { "enum": ["automated", "human"] }, "identity": { "$ref": "urn:zeptly:tiny-agents:schema:common#/$defs/actor" } }
    }
  }
}
