{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zeptly:tiny-agents:schema:registry-root",
  "title": "Registry root marker (PROVISIONAL)",
  "description": "purpose=production forbids synthetic content and placeholder identities; purpose=example REQUIRES every object to be marked synthetic.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryRootVersion", "purpose", "description"],
  "properties": {
    "registryRootVersion": { "const": "registry-root/v0-provisional" },
    "purpose": { "enum": ["production", "example"] },
    "description": { "$ref": "urn:zeptly:tiny-agents:schema:common#/$defs/shortText" }
  }
}
